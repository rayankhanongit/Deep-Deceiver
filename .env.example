# Groq API
GROQ_API_KEY=your_groq_api_key_here

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_token_here
INFLUXDB_ORG=your_influxdb_org_here
INFLUXDB_BUCKET=your_influxdb_bucket_here
# Red Team agent (authorized testing of this application's own model)
RED_TEAM_ENABLED=true
RED_TEAM_MAX_TESTS=10
RED_TEAM_MAX_TURNS=5
RED_TEAM_TIMEOUT=120
RED_TEAM_QUICK_TESTS=3
RED_TEAM_STANDARD_TESTS=7
RED_TEAM_DEEP_TESTS=10
RED_TEAM_STOP_ON_CRITICAL=false
RED_TEAM_LLM_JUDGE=true

# Security alerts
SECURITY_ALERT_THRESHOLD=70
CRITICAL_ALERT_THRESHOLD=85
SECURITY_ALERT_COOLDOWN=5
DESKTOP_NOTIFICATIONS=true
SECURITY_LOG_LEVEL=INFO

# Optional: HTTP bridge to a host-side listener (needed only if the backend
# runs inside Docker - see scripts/host_alert_listener.py)
# SECURITY_WEBHOOK_URL=http://host.docker.internal:8765/alert

# Operator access: required to see security data and run Red Team.
# Choose a long random value; never share it with chat users.
OPERATOR_TOKEN=change_me_to_a_long_random_value
